# Browser build variables (safe public Supabase client values)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare Pages Function secrets / variables
# Configure these once on the Cloudflare Pages project. They persist across deployments.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_AS_CLOUDFLARE_SECRET
ADMIN_EMAILS=teacher@example.ie

# GitHub Actions production environment: production
# Required secrets:
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# SUPABASE_DB_URL
# VITE_SUPABASE_ANON_KEY
#
# Required repository/environment variables:
# CLOUDFLARE_PAGES_PROJECT
# VITE_SUPABASE_URL
#
# Every branch push (including main) deploys to the Cloudflare Pages *Preview* environment
# under the branch alias preview-<branch>. The Production release workflow is manual
# (workflow_dispatch) and performs: Supabase dry-run -> Supabase db push -> Vite build ->
# Cloudflare Pages deploy with --branch=main. Production is deferred until all phases are accepted.
